COMPOSE_PROJECT_NAME=moogle

OLLAMA_IMAGE=ollama/ollama:0.32.15
OLLAMA_MAX_LOADED_MODELS=3
OLLAMA_KEEP_ALIVE=0
OLLAMA_FLASH_ATTENTION=1

ANYTHINGLLM_IMAGE=mintplexlabs/anythingllm:1.16.0
ANYTHINGLLM_PORT=3001
ANYTHINGLLM_LLM_PROVIDER=ollama
ANYTHINGLLM_OLLAMA_BASE_PATH=http://ollama:11434
ANYTHINGLLM_CHAT_MODEL=llama3.2:3b
ANYTHINGLLM_EMBEDDING_ENGINE=generic-openai
ANYTHINGLLM_EMBEDDING_BASE_PATH=http://ollama:11434/v1
ANYTHINGLLM_EMBEDDING_MODEL=mxbai-embed-large
ANYTHINGLLM_GENERIC_OPENAI_EMBEDDING_API_KEY=ollama
ANYTHINGLLM_EMBEDDING_CONCURRENCY=16
ANYTHINGLLM_EMBEDDING_API_DELAY_MS=0
ANYTHINGLLM_VECTOR_DB=lancedb

# Optional GPU overrides used with:
# docker compose -f compose.yaml -f compose.gpu.yaml up -d --wait
# OLLAMA_GPU_COUNT=all
